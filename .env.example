# Local Supabase (Docker: `npx supabase start`). These values are the same on every machine
# and are not secrets. Production keys live in the server env file (/opt/apps/rytm/.env on the VPS), never here.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Shared demo account guard (S-09): password, deletion and import changes are refused for it. On production the owner sets it in the server env file.
DEMO_EMAIL=demo@rytm.local
# Bearer secret for the daily Supabase keep-alive ping (/api/keep-alive). Set in TWO places, rotated together:
# the server env file and the CRON_SECRET repository secret read by .github/workflows/keep-alive.yml.
# Mismatch → the route answers 401 and Supabase is not pinged. Not needed locally; set it only to try the route.
# CRON_SECRET=
