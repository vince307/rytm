---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<div class="border-b border-line bg-paper-soft px-6 py-[11px] text-center text-[13px] text-ink">
  <span class="mr-[9px] mb-px inline-block size-[7px] rounded-full bg-green align-baseline" aria-hidden="true"></span>
  {text}
</div>
