---
// Panel.astro — prototype .panel; `danger` is .danger-panel (copy left, destructive action right).
import { cn } from "@/lib/utils";
interface Props {
  class?: string;
  variant?: "default" | "danger";
}
const { class: className, variant = "default" } = Astro.props;
// Round 3: the danger panel border is `--rytm-danger-line` = `line` (kit `settings.dangerBorder`).
const variantClass =
  variant === "danger"
    ? "border-line flex items-center justify-between gap-5 max-[899px]:flex-col max-[899px]:items-start"
    : "";
---

<section
  class:list={cn("rounded-xl border border-line bg-paper p-[22px] max-[559px]:p-[17px]", variantClass, className)}
>
  <slot />
</section>
