---
// ViewEmpty.astro — prototype .view-empty + .empty-mark (round 2, G18); round 3 centres the panel
// (`.view-empty{margin-left:auto;margin-right:auto}`, adopted at the S-14 visual gate).
import Icon from "@/components/Icon.astro";
import Panel from "@/components/app/Panel.astro";
import { buttonVariants } from "@/components/ui/button";
import type { IconName } from "@/content/copy";
interface Props {
  icon?: IconName;
  headingLevel?: "h1" | "h2";
  arrow?: boolean;
  title: string;
  body: string;
  cta: string;
  href: string;
}
const { icon, headingLevel: Heading = "h2", arrow = true, title, body, cta, href } = Astro.props;
---

<Panel class="mx-auto mt-6 max-w-[720px] px-7 py-14 text-center">
  {icon && (
    <div class="mx-auto mb-[18px] grid size-16 place-items-center rounded-[14px] bg-ink text-paper">
      <Icon name={icon} size={28} />
    </div>
  )}
  <Heading class="mb-2 text-[25px] tracking-[-0.05em]">{title}</Heading>
  <p class="mx-auto mb-5 max-w-[480px] leading-[1.55] text-muted">{body}</p>
  <a href={href} class:list={buttonVariants({ variant: "primary" })}>
    {cta}
    {arrow && (
      <>
        {" "}
        <span aria-hidden="true">↗</span>
      </>
    )}
  </a>
</Panel>
