---
// ViewEmpty.astro — prototype .view-empty + .empty-mark (round 2, G18)
import Icon from "@/components/Icon.astro";
import Panel from "@/components/app/Panel.astro";
import { buttonVariants } from "@/components/ui/button";
import type { IconName } from "@/content/copy";
interface Props {
  icon: IconName;
  title: string;
  body: string;
  cta: string;
  href: string;
}
const { icon, title, body, cta, href } = Astro.props;
---

<Panel class="mt-6 max-w-[720px] px-7 py-14 text-center">
  <div class="mx-auto mb-[18px] grid size-16 place-items-center rounded-[14px] bg-ink text-paper">
    <Icon name={icon} size={28} />
  </div>
  <h2 class="mb-2 text-[25px] tracking-[-0.05em]">{title}</h2>
  <p class="mx-auto mb-5 max-w-[480px] leading-[1.55] text-muted">{body}</p>
  <a href={href} class:list={buttonVariants({ variant: "primary" })}>
    {cta} <span aria-hidden="true">↗</span>
  </a>
</Panel>
