---
// FixedSection.astro — kit `.fixed-section` (prototype `styles.css` `.fixed-section`, `.section-label`,
// `.fixed-list`), one of the three `/fixed` sections (S-06 `fixedOverview`). The list wrapper reuses
// `ExcludedPatterns.astro`'s panel-look shape (`rounded-xl border border-line bg-paper`) with `px-5`, plus the
// kit's `.fixed-list` ≤ 560 px padding that `ExcludedPatterns` has no kit rule for — so the class string is not
// extracted into a shared constant. Not the shared `Panel` component, whose `p-[22px]` cannot be overridden
// reliably under tailwind-merge. The list panel renders only when there are rows: an empty section is explained by
// the page's kit info panel, not by an empty list panel. Row height belongs to `FixedRow`.
import PanelTitle from "@/components/app/PanelTitle.astro";

interface Props {
  title: string;
  count: string;
  hasRows: boolean;
}
const { title, count, hasRows } = Astro.props;
---

<section class="mt-[22px] mb-[22px]">
  <PanelTitle variant="section" title={title}>
    <span class="text-xs text-muted">{count}</span>
  </PanelTitle>
  {hasRows && (
    <div class="rounded-xl border border-line bg-paper px-5 max-[559px]:px-[14px]">
      <slot />
    </div>
  )}
</section>
