---
// ImportPanel.astro — kit `.import-panel` / `.import-copy` / `.import-icon` (prototype/styles.css), the `/home`
// "Dodaj najnowszy wyciąg" panel (FR-013, US-05, S-07 Phase 4). Colour mapping (no dedicated token): dashed border
// `border-muted/55` (kit `#9da9aa`), same nearest-token reasoning `TrendChart.astro` uses for the bar/gridline grey
// (G35 note); background `bg-paper-soft` (kit `#e8ecea`, exact).
import Icon from "@/components/Icon.astro";
import { buttonVariants } from "@/components/ui/button";

interface Props {
  title: string;
  body: string;
  cta: string;
  href: string;
}
const { title, body, cta, href } = Astro.props;
---

<div class="mt-[15px] flex items-center justify-between rounded-xl border border-dashed border-muted/55 bg-paper-soft px-[22px] py-[19px] max-[559px]:flex-col max-[559px]:items-start max-[559px]:gap-[15px]">
  <div class="flex items-center gap-[14px]">
    <span class="grid size-[38px] shrink-0 place-items-center rounded-[10px] bg-ink text-paper">
      <Icon name="import" size={17} />
    </span>
    <div>
      <strong class="block text-[13px]">{title}</strong>
      <span class="mt-[3px] block text-xs text-muted">{body}</span>
    </div>
  </div>
  <a href={href} class:list={buttonVariants({ variant: "ghost" })}>
    {cta}
  </a>
</div>
