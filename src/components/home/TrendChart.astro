---
// TrendChart.astro — kit `trendChart()` (prototype/app.js) + `.monthly-trend` (prototype/styles.css), the `/home`
// monthly "ponad progiem" chart (FR-013, US-05, S-07). Deliberately absent, against the kit: the current month's
// `.tbar.hot` amber bar with its "niepełny" label, and the `trend.current` legend entry (round 2: "bieżący, niepełny
// miesiąc"; round 3 reads "Bieżący miesiąc" and C4 drops "niepełny"; the app reads neither key) — US-05 AC 4: the app
// cannot know a month is incomplete, the reference month is only the latest month present in the data; G35 is
// resolved by kit decision C4, the legend text stays `legend` from the page. Every bar carries a visible sum (the kit's bars
// carry only height) so a historical month's figure never needs a hover/tooltip the kit does not define.
// Colour mapping (G35, no dedicated tokens): bar / legend dot `bg-muted` (kit `--rytm-sequence` = muted, exact; the G35 bar-grey part is closed), dashed gridline
// `border-line` (kit `#d2d7d8`), note via `InfoPanel` (kit `.info-panel`).
import InfoPanel from "@/components/app/InfoPanel.astro";
import { cn } from "@/lib/utils";

// Every string arrives from the page (kit `copy.trend.*`), this component imports no copy.
interface Props {
  bars: { label: string; amount: string; height: number; name: string }[];
  legend: string;
  ariaLabel: string;
  note?: string;
  zeroNote?: string;
  noThreshold?: string;
}
const { bars, legend, ariaLabel, note, zeroNote, noThreshold } = Astro.props;
// Geometry = kit `.monthly-trend` (visual gate, impl review F6): the 200 px `<ol>` is the bar area, its `border-b`
// is the baseline the bars stand on, the dashed gridline sits at its 50 % (`top-[100px]`, kit `.trend:before`), and
// the month labels hang 22 px below the baseline (kit `.tbar:after` `bottom:-22px`) inside the wrapper's `pb-[22px]`,
// so the legend keeps the kit's 31 px from the baseline (9 px + 22 px). `flex-row-reverse` on the scroll box makes a
// long axis that overflows (≈ 400 px viewport, 12 months) open scrolled to its END — the reference month the stat
// card above reports — instead of the oldest one (DOM and reading order unchanged; G35).
---

<div class="flex flex-row-reverse overflow-x-auto">
  <div class="relative min-w-full shrink-0 pb-[22px]">
    <div
      class="pointer-events-none absolute inset-x-0 top-[100px] border-t border-dashed border-line"
      aria-hidden="true"
    ></div>
    <ol aria-label={ariaLabel} class="flex h-[200px] gap-[13px] border-b border-line px-2.5 max-[559px]:gap-[7px]">
      {bars.map((bar) => (
        <li class="relative flex min-w-[44px] flex-1 flex-col items-center">
          <span class="shrink-0 text-[11px] font-bold whitespace-nowrap text-ink max-[559px]:text-[9px] max-[359px]:text-[8px]">
            {bar.amount}
          </span>
          <div class="relative w-full flex-1">
            <i
              role="img"
              aria-label={bar.name}
              class:list={cn(
                "absolute inset-x-0 bottom-0 w-full rounded-t-[3px]",
                bar.height === 0 ? "h-[2px] bg-line" : "bg-muted",
              )}
              style={bar.height > 0 ? `height:${bar.height}%` : undefined}
            ></i>
          </div>
          <span class="absolute -bottom-[22px] left-1/2 -translate-x-1/2 text-[10px] whitespace-nowrap text-muted">
            {bar.label}
          </span>
        </li>
      ))}
    </ol>
  </div>
</div>
<div class="mt-[9px] flex items-center gap-[17px] text-[11px] text-muted">
  <span>
    <i class="mr-[5px] inline-block h-2 w-2 rounded-full bg-muted" aria-hidden="true"></i>
    {legend}
  </span>
  {zeroNote && <span class="ml-auto max-[559px]:text-[10px]">{zeroNote}</span>}
  {noThreshold && <span>{noThreshold}</span>}
</div>
{note && <InfoPanel>{note}</InfoPanel>}
