---
// /fixed — kit `fixedCosts(state)` (prototype `app.js`), FR-012 / US-04 (S-06): `loadPatternData` → `fixedOverview`
// gives all three sections their rows — "Zmieniły kwotę", "Nowe w tym miesiącu" (kit `badge('nowy','new')`) and
// "Bez zmian". One message per state (`fixedNotices`): without a comparison month (one month of data, or a gap month
// between imports) only `noComparison` under the title — AC: not "wszystko jest nowe"; an empty section draws its
// kit info panel in the `.fixed-empty-states` block under the sections, never an empty list panel.
import AppLayout from "@/layouts/AppLayout.astro";
import { Badge } from "@/components/app/Badge";
import FixedRow from "@/components/fixed/FixedRow.astro";
import FixedSection from "@/components/fixed/FixedSection.astro";
import InfoPanel from "@/components/app/InfoPanel.astro";
import InlineAlert from "@/components/app/InlineAlert.astro";
import PageTitle from "@/components/app/PageTitle.astro";
import ViewEmpty from "@/components/app/ViewEmpty.astro";
import { getCopy, getMonths } from "@/content/copy";
import { fillMonthLocative, formatIsoDate, formatMoney, plural } from "@/lib/format";
import { fixedOverview, type FixedOverview } from "@/lib/patterns/fixed";
import { deltaText, fixedNotices, type FixedNotices } from "@/lib/patterns/fixed-view";
import { loadPatternData } from "@/lib/patterns/load";
import { createClient } from "@/lib/supabase";
import { cn } from "@/lib/utils";

const { copy, copyExtra } = getCopy(Astro.locals.locale);

const locale = Astro.locals.locale;

const e = copy.emptyViews;
const x = copyExtra.fixed;

// Same read shape as `/patterns` (`patterns.astro`) — a failed read, including an unconfigured Supabase client,
// never shows the empty state or a partial list.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const dataResult = supabase ? await loadPatternData(supabase) : { error: new Error("Supabase is not configured") };
const result: { error: unknown } | { referenceMonth: null } | { overview: FixedOverview } = (() => {
  if ("error" in dataResult) return { error: dataResult.error };
  // Error boundary (S-14 follow-up): an assembly throw after a good read renders the read-error alert, not a 500.
  try {
    const overview = fixedOverview(dataResult.patterns, dataResult.rows);
    return overview.referenceMonth === null ? { referenceMonth: null } : { overview };
  } catch (err) {
    return { error: err };
  }
})();
const notices: FixedNotices =
  "overview" in result
    ? fixedNotices(result.overview)
    : { noComparison: false, noChanges: false, noNew: false, unchangedEmpty: false };
if ("error" in result) {
  // eslint-disable-next-line no-console -- server-side only; the runtime log is the one place this error is visible
  console.error("fixed costs failed", result.error);
}

// K23 templates — verbatim row/section copy the kit only renders in `app.js` (`fixedCosts()`), not in
// `content.json`; `{n}`/`{items}`/`{date}`/`{amount}` interpolation follows the codebase's `.replace()` convention
// (`patterns/[...key].astro` `sumLabel`, `imports/result.astro` `title`).
const itemForms = copy.fixedCosts.itemForms as [string, string, string]; // 3 forms pinned in kit-contract.test.ts
const countText = (n: number) => x.count.replace("{n}", String(n)).replace("{items}", plural(n, itemForms, locale));
const previouslyText = (occurredOn: string, previousMinor: number) =>
  x.previously
    .replace("{date}", formatIsoDate(occurredOn, locale))
    .replace("{amount}", formatMoney(previousMinor, locale));
const firstSeenText = (firstOccurredOn: string) =>
  x.firstSeen.replace("{date}", formatIsoDate(firstOccurredOn, locale));
// Kit `.increase` (amber) / `.decrease` (green). Kept short (helper, not inline) so prettier never wraps the `<b>`
// element onto three lines — a wrap would put the smoke-asserted delta text on its own indented line, which fails
// the `>text<` anchor (agent-contract smoke-assertion note, plan review F1).
const deltaClass = (deltaMinor: number) =>
  cn("text-[13px] font-bold", deltaMinor > 0 ? "text-excess-text" : "text-green");
---

<AppLayout title={copy.fixedCosts.title} active="fixed">
  {"error" in result ? (
    <>
      <PageTitle eyebrow={copy.app.fixedLong} title={copy.fixedCosts.title} lead={x.lead} />
      <InlineAlert kind="error">{copy.fixedCosts.readError}</InlineAlert>
    </>
  ) : "referenceMonth" in result ? (
    <>
      <PageTitle eyebrow={copy.app.fixedLong} title={e.fixed.title} lead={e.fixed.lead} />
      <ViewEmpty icon="fixed" title={e.cta} body={copyExtra.emptyViews.body} cta={e.button} href="/imports/new" />
    </>
  ) : (
    <>
      <PageTitle eyebrow={copy.app.fixedLong} title={copy.fixedCosts.title} lead={x.lead} />
      {notices.noComparison && <InfoPanel class="mt-0 mb-2">{copy.fixedCosts.noComparison}</InfoPanel>}
      <FixedSection
        title={copy.fixedCosts.changed}
        count={countText(result.overview.changed.length)}
        hasRows={result.overview.changed.length > 0}
      >
        {result.overview.changed.map((row) => (
          <FixedRow
            name={row.name}
            meta={previouslyText(row.occurredOn, row.previousMinor)}
            amount={formatMoney(row.amountMinor, locale)}
          >
            <b class:list={deltaClass(row.deltaMinor)}>{deltaText(row.deltaMinor, x.delta, locale)}</b>
          </FixedRow>
        ))}
      </FixedSection>
      <FixedSection
        title={fillMonthLocative(
          copy.fixedCosts.new,
          result.overview.referenceMonth ?? "",
          getMonths(locale).locative,
          locale,
        )}
        count={countText(result.overview.new.length)}
        hasRows={result.overview.new.length > 0}
      >
        {result.overview.new.map((row) => (
          <FixedRow
            name={row.name}
            meta={firstSeenText(row.firstOccurredOn)}
            amount={formatMoney(row.amountMinor, locale)}
          >
            <Badge tone="new">{copy.components.new}</Badge>
          </FixedRow>
        ))}
      </FixedSection>
      <FixedSection
        title={copy.fixedCosts.unchanged}
        count={countText(result.overview.unchanged.length)}
        hasRows={result.overview.unchanged.length > 0}
      >
        {result.overview.unchanged.map((row) => (
          <FixedRow name={row.name} amount={formatMoney(row.amountMinor, locale)} compact />
        ))}
      </FixedSection>
      {(notices.noChanges || notices.noNew || notices.unchangedEmpty) && (
        <div class="mt-3 grid gap-2.5">
          {notices.noChanges && <InfoPanel class="mt-0">{copy.fixedCosts.noChanges}</InfoPanel>}
          {notices.noNew && <InfoPanel class="mt-0">{copy.fixedCosts.noNew}</InfoPanel>}
          {notices.unchangedEmpty && <InfoPanel class="mt-0">{x.unchangedEmpty}</InfoPanel>}
        </div>
      )}
    </>
  )}
</AppLayout>
