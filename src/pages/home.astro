---
// /home — kit `dashboard()` no-name variant (`#/home-no-name`, K5) + `trendChart()` `.monthly-trend` + the
// `.import-panel` (FR-013, US-05, FR-012, US-04, S-07). `loadPatternData` → `overLimitTrend(patterns, rows,
// thresholds)` → `fixedOverview(patterns, rows)` → `homeStats(trend, fixed)`, all inside one `try` (S-06
// follow-up: a `patternTxs` id-drift throw must not become a 500 here; `/patterns` and `/fixed` are not
// retrofitted — one view, tracked as a follow-up). The pre-import state (`referenceMonth === null`) is
// unchanged from before this change.
import AppLayout from "@/layouts/AppLayout.astro";
import EmptyState from "@/components/app/EmptyState.astro";
import InlineAlert from "@/components/app/InlineAlert.astro";
import PageTitle from "@/components/app/PageTitle.astro";
import Panel from "@/components/app/Panel.astro";
import ImportPanel from "@/components/home/ImportPanel.astro";
import StatCard from "@/components/home/StatCard.astro";
import TrendChart from "@/components/home/TrendChart.astro";
import { buttonVariants } from "@/components/ui/button";
import { copy, copyExtra } from "@/content/copy";
import { formatMoney, formatMonthAxis, formatSignedMoney, plural } from "@/lib/format";
import { fixedOverview } from "@/lib/patterns/fixed";
import { homeStats, type HomeStats } from "@/lib/patterns/home";
import { loadPatternData } from "@/lib/patterns/load";
import { overLimitTrend, trendBarHeight, type OverLimitTrend } from "@/lib/patterns/trend";
import { createClient } from "@/lib/supabase";

const h = copyExtra.home;
const e = copy.emptyState;

// Same read shape as `/patterns` and `/fixed` — a failed read, including an unconfigured Supabase client, never
// shows the empty state or a partial view.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const dataResult = supabase ? await loadPatternData(supabase) : { error: new Error("Supabase is not configured") };
// `referenceMonth` narrowed to `string` on the data branch, so the lead never needs a fallback (impl review).
type HomeResult =
  { error: unknown } | { referenceMonth: null } | { trend: OverLimitTrend; referenceMonth: string; stats: HomeStats };
const result: HomeResult = (() => {
  if ("error" in dataResult) return { error: dataResult.error };
  try {
    const trend = overLimitTrend(dataResult.patterns, dataResult.rows, dataResult.thresholds);
    if (trend.referenceMonth === null) return { referenceMonth: null };
    const fixed = fixedOverview(dataResult.patterns, dataResult.rows);
    return { trend, referenceMonth: trend.referenceMonth, stats: homeStats(trend, fixed) };
  } catch (err) {
    return { error: err };
  }
})();
if ("error" in result) {
  // eslint-disable-next-line no-console -- server-side only; the runtime log is the one place this error is visible
  console.error("home failed", result.error);
}

// K24 template — verbatim lead from `applyDashboardState` (`#/home-no-name`); `{month}` + `monthsNominative`
// generalise the kit's baked-in "maj" (`patterns.astro` `sumLabel` precedent).
// `2026-05` → 4 — index into the `months*` declension tables below (one parse for both K24 and K25 templates).
const monthIndex = (yearMonth: string) => Number(yearMonth.split("-")[1]) - 1;

const leadFor = (month: string) => h.lead.replace("{month}", h.monthsNominative[monthIndex(month)]);

const barsFor = (trend: OverLimitTrend) => {
  const max = Math.max(0, ...trend.months.map((m) => m.overMinor));
  return trend.months.map((m) => ({
    label: formatMonthAxis(m.month),
    amount: formatMoney(m.overMinor),
    height: trendBarHeight(m.overMinor, max),
  }));
};

// K25 templates — kit `content.json` `dashboard.stats[].foot` prints these only as samples; `{delta}` / `{month}`
// and `{n}` / `{items}` generalise them (K24 `leadFor` precedent).
const deltaFootFor = (previous: NonNullable<HomeStats["previous"]>) =>
  h.deltaFoot
    .replace("{delta}", formatSignedMoney(previous.deltaMinor))
    .replace("{month}", h.monthsGenitive[monthIndex(previous.month)]);

const risenFootFor = (n: number) => h.risen.replace("{n}", String(n)).replace("{items}", plural(n, h.risenForms));
---

<AppLayout title={copy.dashboard.eyebrow} active="home">
  {"error" in result ? (
    <>
      <PageTitle eyebrow={copy.dashboard.eyebrow} title={copy.dashboard.greetingNoName} />
      <InlineAlert kind="error">{copy.components.error}</InlineAlert>
    </>
  ) : result.referenceMonth === null ? (
    <>
      <PageTitle eyebrow={h.emptyEyebrow} title={h.emptyTitle} lead={h.emptyLead} />
      <EmptyState
        title={e.title}
        body={e.body}
        cta={e.cta}
        href="/imports/new"
        illustration="/rytm/illustrations/rytm-pusty-stan-jasny.svg"
        illustrationAlt={h.emptyIllustrationAlt}
      />
    </>
  ) : (
    <>
      {/* DESIGN-GAP: K24 — no-name lead, month generalised (see leadFor above). */}
      <PageTitle
        eyebrow={copy.dashboard.eyebrow}
        title={copy.dashboard.greetingNoName}
        lead={leadFor(result.referenceMonth)}
      >
        <a href="/imports/new" class:list={buttonVariants({ variant: "primary" })}>
          {copyExtra.patterns.upload}
        </a>
      </PageTitle>
      <div class="mb-[15px] grid grid-cols-[1.2fr_1fr] gap-[15px] max-[899px]:grid-cols-1">
        <StatCard
          accent
          label={copy.dashboard.stats[0].label}
          value={formatMoney(result.stats.overMinor)}
          foot={result.stats.previous ? deltaFootFor(result.stats.previous) : undefined}
        />
        <StatCard
          label={copy.dashboard.stats[1].label}
          value={formatMoney(result.stats.fixedTotalMinor)}
          foot={risenFootFor(result.stats.fixedRisen)}
        />
      </div>
      <Panel>
        <div class="mb-5 flex items-start justify-between">
          <h2 class="text-[17px] tracking-[-0.03em]">{copy.trend.title}</h2>
          <span class="text-xs text-muted">{copy.trend.range}</span>
        </div>
        <TrendChart
          ariaLabel={copy.trend.title}
          bars={barsFor(result.trend)}
          legend={copy.trend.legend}
          note={
            result.trend.months.length < copy.trend.minimumMonths
              ? copy.trend.tooShort.replace("{n}", String(copy.trend.minimumMonths))
              : undefined
          }
          hint={!result.trend.hasThreshold ? h.noThreshold : undefined}
        />
      </Panel>
      <ImportPanel
        title={copy.dashboard.importTitle}
        body={copy.dashboard.importBody}
        cta={copyExtra.imports.choose}
        href="/imports/new"
      />
    </>
  )}
</AppLayout>
