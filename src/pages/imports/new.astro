---
// New import (S-01) — steps 1–3 run in the ImportWizard island (prototype app.js:57–61). The page hands it the
// caller's own import ranges (RLS, FR-002) for the step-3 overlap check and the error of a rejected POST.
import { z } from "zod";
import { DEMO_EMAIL } from "astro:env/server";
import AppLayout from "@/layouts/AppLayout.astro";
import ImportWizard from "@/components/imports/ImportWizard";
import type { ExistingImport, WizardServerError } from "@/components/imports/ImportWizard";
import { getCopy } from "@/content/copy";
import { createClient } from "@/lib/supabase";
import { demoImportAllowed, isDemoEmail } from "@/lib/demo";

const { copy, copyExtra } = getCopy(Astro.locals.locale);

const f = copy.importFlow;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { data, error } = supabase
  ? await supabase.from("imports").select("account_number, period_start, period_end")
  : { data: null, error: null };
if (error) {
  // eslint-disable-next-line no-console -- server-side only; the runtime log is the one place this error is visible
  console.error("imports ranges failed", error.code, error.message);
}
const existing: ExistingImport[] = (data ?? []).map((i) => ({
  accountNumber: i.account_number,
  periodStart: i.period_start,
  periodEnd: i.period_end,
}));

// The shared demo account may import only while empty (S-09). A read error fails closed like the endpoint's
// `count ?? 1`: `existing` is `data ?? []`, so `existing.length` alone would be 0 and fail open.
const demoLocked = isDemoEmail(Astro.locals.user?.email, DEMO_EMAIL) && !demoImportAllowed(error ? 1 : existing.length);

// ?error= from POST /api/imports; overlap carries the colliding range unless the endpoint could not read it;
// demo is the shared demo account's refusal (S-09).
const params = Astro.url.searchParams;
const kind = z.enum(["overlap", "invalid", "failed", "demo"]).safeParse(params.get("error"));
const isoDate = (value: string | null) => {
  const parsed = z.iso.date().safeParse(value);
  return parsed.success ? parsed.data : undefined;
};
const serverError: WizardServerError | undefined = kind.success
  ? { kind: kind.data, from: isoDate(params.get("from")), to: isoDate(params.get("to")) }
  : undefined;
---

<AppLayout title={f.title} active="imports">
  <ImportWizard
    client:load
    locale={Astro.locals.locale}
    labels={{
      flow: {
        title: f.title,
        steps: f.steps,
        supported: f.supported,
        oneAccount: f.oneAccount,
        bank: f.bank,
        accountLabel: f.accountLabel,
        rangeLabel: f.rangeLabel,
        importButton: f.importButton,
        debitForms: f.debitForms as [string, string, string],
        waiting: f.waiting,
        back: f.back,
        demoImportBlocked: f.demoImportBlocked,
      },
      kit: copy.imports,
      imports: copyExtra.imports,
      errors: copy.importErrors,
      genericError: copyExtra.imports.saveError,
    }}
    existing={existing}
    serverError={serverError}
    demoLocked={demoLocked}
  />
</AppLayout>
