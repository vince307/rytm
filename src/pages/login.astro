---
import AuthLayout from "@/layouts/AuthLayout.astro";
import SignInForm from "@/components/auth/SignInForm";
import InlineAlert from "@/components/app/InlineAlert.astro";
import { getCopy } from "@/content/copy";

const { copy, copyExtra } = getCopy(Astro.locals.locale);

const hasError = Astro.url.searchParams.has("error");
// Kit round 2: #/login?confirmed=1 — the confirmation link was verified but /auth/callback could not open a session here.
const confirmed = Astro.url.searchParams.has("confirmed");
// Kit round 3 `login-deleted.html`: the account was deleted; /api/auth/delete lands here with the session already
// cleared. Notice text `settings.deletedNotice`.
const deleted = Astro.url.searchParams.has("deleted");
const a = copy.auth;
const s = copy.authStates;
const x = copyExtra.auth;
---

<AuthLayout title={a.login.title} visual={a.loginVisual}>
  {confirmed && (
    <div class="mb-[22px]">
      <InlineAlert kind="success">{x.confirmedLogin}</InlineAlert>
    </div>
  )}
  {deleted && (
    <div class="mb-[22px]">
      <InlineAlert kind="success">{copy.settings.deletedNotice}</InlineAlert>
    </div>
  )}
  <div class="text-xs font-extrabold tracking-[0.14em] text-excess-text uppercase">{a.login.eyebrow}</div>
  <h1 class="mt-4 mb-2 text-[34px] tracking-[-0.06em]">{a.login.title}</h1>
  <p class="mb-7 text-sm text-muted">{a.login.description}</p>
  <SignInForm
    client:load
    serverError={hasError ? s.loginError : null}
    forgotPassword={{ href: "/reset", label: a.forgotPassword }}
    labels={{
      email: a.fields.email,
      password: a.fields.password,
      emailPlaceholder: a.emailPlaceholder,
      passwordPlaceholder: a.passwordPlaceholder,
      showPassword: s.showPassword,
      hidePassword: s.hidePassword,
      submit: copy.navigation.login,
      pending: s.signingIn,
      emailRequired: s.emailRequired,
      passwordRequired: s.passwordRequired,
    }}
  />
  <p class="text-center text-[13px] text-muted">
    {a.noAccount}{" "}
    <a href="/register" class="font-bold text-excess-text">
      {a.createIt}
    </a>
  </p>
</AuthLayout>
