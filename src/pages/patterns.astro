---
import AppLayout from "@/layouts/AppLayout.astro";
import PageTitle from "@/components/app/PageTitle.astro";
import ViewEmpty from "@/components/app/ViewEmpty.astro";
import { copy, copyExtra } from "@/content/copy";

const e = copy.emptyViews;
---

<AppLayout title={copy.patterns.title} active="patterns">
  <PageTitle eyebrow={copyExtra.patterns.eyebrow} title={e.patterns.title} lead={e.patterns.lead} />
  <ViewEmpty icon="patterns" title={e.cta} body={copyExtra.emptyViews.body} cta={e.button} href="/imports/new" />
</AppLayout>
