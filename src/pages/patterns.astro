---
import AppLayout from "@/layouts/AppLayout.astro";
import InlineAlert from "@/components/app/InlineAlert.astro";
import PageTitle from "@/components/app/PageTitle.astro";
import ViewEmpty from "@/components/app/ViewEmpty.astro";
import ExcludedPatterns from "@/components/patterns/ExcludedPatterns.astro";
import { PatternsTable, type PatternsTableCopy } from "@/components/patterns/PatternsTable";
import { buttonVariants } from "@/components/ui/button";
import { copy, copyExtra } from "@/content/copy";
import { loadPatternData } from "@/lib/patterns/load";
import { createClient } from "@/lib/supabase";
import { listOverview } from "@/lib/patterns/view";
import type { PatternListItem } from "@/types";

const e = copy.emptyViews;
const x = copyExtra.patterns;

// Patterns are derived on read from the caller's own debits (RLS, FR-006/FR-007) — prototype patterns() (app.js).
// A failed read — including an unconfigured Supabase client — never shows the empty state or a partial list.
// `loadPatternData` reads transactions, thresholds and decisions in one call (S-04 impl-review F7); `listOverview` returns
// island-ready items directly — no second `Map` re-merge here.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const dataResult = supabase ? await loadPatternData(supabase) : { error: new Error("Supabase is not configured") };
const result: { error: unknown } | { patterns: PatternListItem[] } = (() => {
  if ("error" in dataResult) return { error: dataResult.error };
  try {
    const { items } = listOverview(dataResult.patterns, dataResult.rows, dataResult.thresholds);
    return { patterns: items };
  } catch (error) {
    return { error };
  }
})();
if ("error" in result) {
  // eslint-disable-next-line no-console -- server-side only; the runtime log is the one place this error is visible
  console.error("patterns list failed", result.error);
}
const items: PatternListItem[] = "patterns" in result ? result.patterns : [];
// Excluded patterns leave the table for the "Wykluczone" section below it (S-05 Phase 7, G28); the empty state
// (below) still keys off `items.length` — a list of only-excluded patterns is not "no patterns at all".
const visibleItems = items.filter((p) => !p.excluded);
const excludedItems = items.filter((p) => p.excluded).map((p) => ({ key: p.key, name: p.name }));

// Decision result line above the table (Phase 7's own restore form posts `back=list`) — mirrors the detail
// page's `decisionAlert` (Phase 6), but the only outcomes that can land here are `restored` and `error=decision`.
const params = Astro.url.searchParams;
const resultAlert = params.get("restored")
  ? { kind: "success" as const, message: copy.patternActions.restored }
  : params.get("error") === "decision"
    ? { kind: "error" as const, message: x.decisionError }
    : null;

const tableCopy: PatternsTableCopy = {
  searchPlaceholder: copy.patterns.searchPlaceholder,
  sortOptions: copy.patterns.sortOptions,
  sortPrefix: x.sortPrefix,
  columns: copy.patterns.columns,
  typeLabels: x.typeLabels,
  footer: x.footer,
  patternForms: copy.patterns.countForms,
  thresholdCount: x.thresholdCount,
  thresholdSum: x.thresholdSum,
  openPattern: x.openPattern,
};
---

<AppLayout title={copy.patterns.title} active="patterns">
  {"error" in result ? (
    <>
      <PageTitle eyebrow={copy.app.patternsLong} title={copy.patterns.title} lead={copy.patterns.description} />
      <InlineAlert kind="error">{copy.components.error}</InlineAlert>
    </>
  ) : items.length === 0 ? (
    <>
      <PageTitle eyebrow={copy.app.patternsLong} title={e.patterns.title} lead={e.patterns.lead} />
      <ViewEmpty icon="patterns" title={e.cta} body={copyExtra.emptyViews.body} cta={e.button} href="/imports/new" />
    </>
  ) : (
    <>
      <PageTitle eyebrow={copy.app.patternsLong} title={copy.patterns.title} lead={copy.patterns.description}>
        <a href="/imports/new" class:list={buttonVariants({ variant: "primary" })}>
          {x.upload}
        </a>
      </PageTitle>
      {resultAlert && (
        <div class="mb-[18px]">
          <InlineAlert kind={resultAlert.kind}>{resultAlert.message}</InlineAlert>
        </div>
      )}
      <PatternsTable client:load patterns={visibleItems} copy={tableCopy} />
      <ExcludedPatterns patterns={excludedItems} />
    </>
  )}
</AppLayout>
