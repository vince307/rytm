---
// Pattern detail (S-04; "Akcje" menu + excluded banner + merged variants added S-05 faza 6). Bound to the kit
// `patternDetail()` (prototype/app.js); the threshold panel renders `ThresholdEditor`, which posts to
// `/api/patterns/threshold` (+ `/delete`); the actions dialog (`PatternActionsDialog`) and the excluded banner's
// `RestoreForm` post to `/api/patterns/decision`.
// A rest route (`[...key]`) so a key containing `/` still matches; the key is read from the raw, percent-encoded
// pathname (`keyFromPath`), never `Astro.params` — see plan Critical Implementation Details.
import AppLayout from "@/layouts/AppLayout.astro";
import BackLink from "@/components/app/BackLink.astro";
import InlineAlert from "@/components/app/InlineAlert.astro";
import ViewEmpty from "@/components/app/ViewEmpty.astro";
import Icon from "@/components/Icon.astro";
import Panel from "@/components/app/Panel.astro";
import SequenceMark from "@/components/app/SequenceMark.astro";
import { Badge } from "@/components/app/Badge";
import { buttonVariants } from "@/components/ui/button";
import { MonthSelect } from "@/components/patterns/MonthSelect";
import PatternActionsDialog, { type PatternActionsCopy } from "@/components/patterns/PatternActionsDialog";
import RestoreForm from "@/components/patterns/RestoreForm.astro";
import { ThresholdEditor, type ThresholdEditorCopy } from "@/components/patterns/ThresholdEditor";
import { copy, copyExtra } from "@/content/copy";
import { fillMonthLocative, formatIsoDate, formatMoney, formatMonthShort, plural } from "@/lib/format";
import { DISPLAY_NAME_MAX } from "@/lib/patterns/decision-form";
import { loadPatternData } from "@/lib/patterns/load";
import { sequenceLabel } from "@/lib/patterns/sequence-label";
import { referenceMonth } from "@/lib/patterns/over-limit";
import { keyFromPath, patternHref } from "@/lib/patterns/path";
import { detailTarget, patternDetail, type DetailTarget, type PatternDetailView } from "@/lib/patterns/view";
import { createClient } from "@/lib/supabase";
import type { MerchantPattern } from "@/types";

const x = copyExtra.patterns;

const key = keyFromPath(Astro.url.pathname);
if (key === null) {
  return Astro.redirect("/patterns");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
const dataResult = supabase ? await loadPatternData(supabase) : { error: new Error("Supabase is not configured") };

const readError = "error" in dataResult ? dataResult.error : null;
if (readError) {
  // eslint-disable-next-line no-console -- server-side only; the runtime log is the one place this error is visible
  console.error("pattern detail failed", readError);
}

// Assembly boundary (S-14 F8): an id drift inside `detailTarget` / `patternDetail` / `sequenceLabel` lands in the
// existing read-error branch. Redirects are `return`s (not throws), so the `try` does not swallow them; the `catch`
// resets every binding the template reads to its default, so no actions dialog or 404 renders next to the error.
let assemblyError: unknown = null;
let pattern: MerchantPattern | undefined;
let detail: PatternDetailView | null = null;
let month = "";
let monthOptions: { value: string; label: string }[] = [];
let sumLabel = "";
let overLabel = "";
let sequenceSummary = "";
const monthLocatives = Object.values(copy.patternDetail.monthNames);

try {
  // Resolves the requested key through the decisions before looking it up (S-05): an absorbed key's URL redirects
  // to its current root; `missing` covers both an unknown key and an owning-import deletion (S-04 decision 8).
  const target: DetailTarget | null =
    readError || !("patterns" in dataResult) ? null : detailTarget(key, dataResult.patterns, dataResult.decisions);

  const redirectHref = target?.kind === "redirect" ? patternHref(target.key) : null;
  if (redirectHref !== null) {
    return Astro.redirect(redirectHref, 302);
  }
  pattern = target?.kind === "found" ? target.pattern : undefined;

  if (pattern && "rows" in dataResult) {
    const refMonth = referenceMonth(dataResult.rows);
    if (!refMonth) {
      // Unreachable: `pattern` was derived from these same `rows`, so a match implies at least one row.
      return Astro.redirect("/patterns");
    }
    const threshold = dataResult.thresholds.get(key) ?? null;
    detail = patternDetail(pattern, dataResult.rows, threshold, refMonth, Astro.url.searchParams.get("month"));
    month = detail.month ?? refMonth;
    monthOptions = detail.months.map((m) => ({ value: m, label: formatMonthShort(m) }));
    sumLabel = fillMonthLocative(copy.patternDetail.sumLabel, month, monthLocatives);
    // DESIGN-GAP: G31 — `overInMonth` is the one detail string the kit does not define.
    overLabel =
      month === refMonth ? copy.dashboard.stats[0].label : fillMonthLocative(x.overInMonth, month, monthLocatives);
    const overCount = detail.sequence.filter(Boolean).length;
    sequenceSummary = sequenceLabel(detail.count, overCount, x.sequenceSummary, x.occurrenceForms);
  }
} catch (err) {
  assemblyError = err;
  // eslint-disable-next-line no-console -- server-side only; the runtime log is the one place this error is visible
  console.error("pattern detail failed", err);
  pattern = undefined;
  detail = null;
  month = "";
  monthOptions = [];
  sumLabel = "";
  overLabel = "";
  sequenceSummary = "";
}
const pageError = readError ?? assemblyError;

if (!pageError && !pattern) {
  Astro.response.status = 404;
}

// Kit `patternDetail.notFound` = title + body in one string; the title keeps its full stop.
const notFoundSplit = copy.patternDetail.notFound.indexOf(". ") + 1;
const notFoundTitle = copy.patternDetail.notFound.slice(0, notFoundSplit);
const notFoundBody = copy.patternDetail.notFound.slice(notFoundSplit).trim();

const rawDescription = (t: { counterparty: string; title: string }) =>
  t.title ? `${t.counterparty} · ${t.title}` : t.counterparty;
const editorCopy: ThresholdEditorCopy = {
  acceptedAmount: copy.threshold.acceptedAmount,
  countPerMonth: copy.threshold.countPerMonth,
  sumPerMonth: copy.threshold.sumPerMonth,
  valueLabel: { amount: copy.threshold.amount, count: copy.threshold.count },
  suffix: { money: copy.threshold.unitCurrency, count: copy.threshold.unitCount },
  empty: copy.threshold.empty,
  active: copy.threshold.active,
  setThreshold: x.setThreshold,
  save: copy.threshold.save,
  remove: copy.threshold.remove,
  saving: copy.threshold.saving,
};

const actionsCopy: PatternActionsCopy = {
  actions: x.actions,
  eyebrow: copy.patternActions.eyebrow,
  title: copy.patternActions.title,
  lead: copy.patternActions.lead,
  close: copy.patternActions.closeLabel,
  saving: copy.patternActions.saving,
  merge: copy.patternActions.merge,
  changeType: copy.patternActions.changeType,
  rename: copy.patternActions.rename,
  exclude: copy.patternActions.exclude,
  mergeTitle: copy.patternActions.mergeTitle,
  mergeLead: copy.patternActions.mergeLead,
  mergeEmpty: copy.patternActions.mergeEmpty,
  mergeField: x.mergeField,
  mergeSubmit: x.mergeSubmit,
  renameTitle: copy.patternActions.renameTitle,
  renameLabel: copy.patternActions.renamePlaceholder,
  renameHint: x.renameHint,
  renameSubmit: copy.patternActions.save,
};

// The stored rename override of this pattern ("" = none): the rename field's value, so an untouched save posts what
// is already stored (an empty value writes no override) instead of freezing the statement name as one (F5).
const storedName =
  pattern && "patterns" in dataResult ? (dataResult.decisions.get(pattern.key)?.displayName ?? "") : "";

// Other analysed (non-excluded — S-05 decision 7: a merge target must not itself be excluded), non-self patterns,
// sorted by name (`pl`) — mirrors validateMerge's own root/excluded checks so the picker never offers a target the
// endpoint would then reject.
const mergeTargets =
  pattern && "patterns" in dataResult
    ? dataResult.patterns
        .filter((p) => p.key !== pattern.key && !p.excluded)
        .map((p) => ({ key: p.key, name: p.name }))
        .sort((a, b) => a.name.localeCompare(b.name, "pl"))
    : [];

// Result lines above the editor (S-04 decision 15: redirect + InlineAlert, no Toast component) — threshold saves
// only; decision results (S-05) get their own alert under `.detail-top` (`decisionAlert` below) since a decision
// redirect never carries `saved`/`removed`/`error=value|save` and vice versa (mutually exclusive query params).
const params = Astro.url.searchParams;
// DESIGN-GAP: K36 — kit `threshold.invalid` omits the range / two-decimals rule `parseThresholdValue` enforces.
const resultAlert = params.get("saved")
  ? { kind: "success" as const, message: copy.components.success }
  : params.get("removed")
    ? { kind: "success" as const, message: x.thresholdRemoved }
    : params.get("error") === "value"
      ? { kind: "error" as const, message: copy.threshold.invalid }
      : params.get("error") === "save"
        ? { kind: "error" as const, message: copy.threshold.saveError }
        : null;

// Kit `.text-button` (K21 style precedent) — kept short so the unmerge button's rendered text stays inline
// (`>text<`, no wrapping whitespace) for the smoke assertion (agent contract text-anchor rule).
const unmergeClass = buttonVariants({ variant: "text", size: "inline" });

// Decision result line (S-05 Phase 6), rendered under `.detail-top`, above the heading.
const decisionAlert = params.get("merged")
  ? { kind: "success" as const, message: copy.patternActions.merged }
  : params.get("unmerged")
    ? { kind: "success" as const, message: x.unmerged }
    : params.get("typed")
      ? { kind: "success" as const, message: copy.patternActions.typeChanged }
      : params.get("renamed")
        ? { kind: "success" as const, message: copy.patternActions.renamed }
        : params.get("excluded")
          ? { kind: "success" as const, message: copy.patternActions.excludedToast }
          : params.get("restored")
            ? { kind: "success" as const, message: copy.patternActions.restored }
            : params.get("error") === "merge"
              ? { kind: "error" as const, message: copy.patternActions.mergeInvalid }
              : params.get("error") === "name"
                ? {
                    kind: "error" as const,
                    message: copy.patternActions.renameLong.replace("{n}", String(DISPLAY_NAME_MAX)),
                  }
                : params.get("error") === "decision"
                  ? { kind: "error" as const, message: copy.patternActions.saveError }
                  : null;
---

<AppLayout title={pattern ? pattern.name : copy.patterns.title} active="patterns">
  {(pageError !== null || pattern !== undefined) && (
    <div class="detail-top mb-[22px] flex items-center justify-between gap-3 max-[560px]:flex-col max-[560px]:items-stretch">
      <BackLink href="/patterns" label={copy.patternDetail.back} />
      {pattern && (
        <PatternActionsDialog
          client:load
          patternKey={pattern.key}
          type={pattern.type}
          name={pattern.name}
          storedName={storedName}
          excluded={pattern.excluded}
          mergeTargets={mergeTargets}
          copy={actionsCopy}
        />
      )}
    </div>
  )}
  {pageError ? (
    <InlineAlert kind="error">{copy.components.error}</InlineAlert>
  ) : !pattern ? (
    <ViewEmpty
      headingLevel="h1"
      arrow={false}
      title={notFoundTitle}
      body={notFoundBody}
      cta={copy.patternDetail.back}
      href="/patterns"
    />
  ) : detail ? (
    <>
      {decisionAlert && (
        <div class="mb-[18px]">
          <InlineAlert kind={decisionAlert.kind}>{decisionAlert.message}</InlineAlert>
        </div>
      )}
      {pattern.excluded && (
        <div class="mb-[18px]">
          {/* Kit `.excluded-banner{justify-content:space-between}`: „Przywróć” sits at the right edge of the row (the
              kit's three flex items also centre the text — a side effect not copied: the text stays by its icon). */}
          <InlineAlert kind="info" bodyClass="flex flex-1 flex-wrap items-center justify-between gap-x-3 gap-y-1">
            <span>{copy.patternActions.excluded}</span>
            <RestoreForm patternKey={pattern.key} />
          </InlineAlert>
        </div>
      )}
      <section class="mb-7 flex items-end justify-between gap-5 max-[899px]:flex-col max-[899px]:items-start max-[899px]:gap-6">
        <div>
          <div class="text-xs font-extrabold tracking-[0.14em] text-excess-text uppercase">
            <Badge tone={pattern.type}>{x.typeLabels[pattern.type]}</Badge>
            {x.detailEyebrow}
          </div>
          <h1 class="mt-3 mb-[7px] text-[44px] tracking-[-0.07em] max-[899px]:text-[38px]">{pattern.name}</h1>
          <p class="m-0 text-muted">
            {pattern.type === "fixed" ? copy.patternDetail.typeFixed : copy.patternDetail.typeFrequent}
          </p>
        </div>
        <div class="text-right max-[899px]:text-left">
          <span class="block text-xs text-muted">{sumLabel}</span>
          <strong class="my-[7px] block text-[28px] tracking-[-0.06em]">{formatMoney(detail.sumMinor)}</strong>
          <small class="block text-xs text-muted">
            {detail.count} {plural(detail.count, x.occurrenceForms)}
          </small>
          <div class="mt-3">
            <span class="block text-xs text-muted">{overLabel}</span>
            <strong class="text-excess-text text-[15px] font-extrabold">{formatMoney(detail.overMinor)}</strong>
          </div>
        </div>
      </section>

      <section class="grid grid-cols-[1fr_1.15fr] gap-[15px] max-[899px]:grid-cols-1">
        <Panel>
          <div class="mb-5 flex items-start justify-between gap-3">
            <h2 class="m-0 text-[17px] tracking-[-0.03em]">{copy.threshold.title}</h2>
            <span class="text-xs text-muted">
              {detail.threshold ? copy.threshold.activeLabel : copy.threshold.noThreshold}
            </span>
          </div>
          {resultAlert && (
            <div class="mb-4">
              <InlineAlert kind={resultAlert.kind}>{resultAlert.message}</InlineAlert>
            </div>
          )}
          <ThresholdEditor
            client:load
            patternKey={key}
            type={pattern.type}
            threshold={detail.threshold}
            month={month}
            copy={editorCopy}
          />
        </Panel>
        <Panel>
          <div class="mb-5 flex items-start justify-between gap-3">
            <h2 class="m-0 text-[17px] tracking-[-0.03em]">{copy.patternDetail.monthSelect}</h2>
            <MonthSelect client:load months={monthOptions} value={month} label={copy.patternDetail.monthSelect} />
          </div>
          {detail.count > 0 ? (
            <>
              <div
                class="flex min-h-[120px] flex-wrap items-center gap-[9px] py-[15px]"
                role="img"
                aria-label={sequenceSummary}
              >
                {detail.sequence.map((over) => (
                  <SequenceMark over={over} />
                ))}
              </div>
              <div class="flex justify-between text-xs text-muted">
                <span>{copy.patternDetail.sequenceWithin}</span>
                <b class="text-excess-text font-bold">{copy.patternDetail.sequenceOver}</b>
              </div>
            </>
          ) : (
            <div class="flex min-h-[120px] items-center justify-center gap-2.5 text-sm text-muted">
              <Icon name="info" size={18} />
              <span>{copy.patternDetail.noOccurrences}</span>
            </div>
          )}
        </Panel>
      </section>

      <Panel class="mt-[15px]">
        <div class="mb-5 flex items-start justify-between gap-3">
          <h2 class="m-0 text-[17px] tracking-[-0.03em]">{copy.patternDetail.transactions}</h2>
          <span class="text-xs text-muted">{copy.patternDetail.rawDescription}</span>
        </div>
        {detail.count === 0 ? (
          // DESIGN-GAP: K37 — kit `app.js` literal, no content.json key.
          <p class="text-muted">{x.noTransactions}</p>
        ) : (
          <div>
            {detail.transactions.map((t) => (
              <div class="flex items-center justify-between gap-3 border-b border-line py-[14px] last:border-b-0">
                <div class="min-w-0">
                  <div class="text-[13px] font-bold">{formatIsoDate(t.occurredOn)}</div>
                  <div class="mt-[3px] text-[11px] text-muted">{rawDescription(t)}</div>
                </div>
                {/* a real raw description is far longer than the kit's "WOLT*WARSAW": the amount never wraps */}
                <div class="flex shrink-0 items-center gap-3">
                  <strong class="text-[14px] whitespace-nowrap">{formatMoney(t.amountMinor)}</strong>
                  {t.overMinor > 0 && <Badge tone="excess">{x.overBadge}</Badge>}
                </div>
              </div>
            ))}
          </div>
        )}
        {pattern.merged.length > 0 && (
          <div class="mt-5 border-t border-line pt-[15px]">
            <h3 class="mb-2 text-[13px]">{copy.patternActions.mergedVariants}</h3>
            <div class="grid gap-2">
              {pattern.merged.map((variant) => (
                <div class="flex items-center justify-between gap-3">
                  <span class="text-[13px] text-muted">{variant.name}</span>
                  <form method="POST" action="/api/patterns/decision">
                    <input type="hidden" name="key" value={pattern.key} />
                    <input type="hidden" name="action" value="unmerge" />
                    <input type="hidden" name="source" value={variant.key} />
                    {/* No type="submit" — see RestoreForm.astro's comment (prettier-plugin-astro breaks a
                        multi-attribute button, which would defeat the smoke `>text<` anchor below). */}
                    <button class:list={[unmergeClass]}>{copy.patternActions.undoMerge}</button>
                  </form>
                </div>
              ))}
            </div>
          </div>
        )}
      </Panel>
    </>
  ) : null}
</AppLayout>
