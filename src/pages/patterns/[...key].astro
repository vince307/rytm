---
// Pattern detail (S-04). Bound to the kit `patternDetail()` (prototype/app.js) minus the "Akcje" menu (S-05);
// the threshold panel renders `ThresholdEditor`, which posts to `/api/patterns/threshold` (+ `/delete`).
// A rest route (`[...key]`) so a key containing `/` still matches; the key is read from the raw, percent-encoded
// pathname (`keyFromPath`), never `Astro.params` — see plan Critical Implementation Details.
import AppLayout from "@/layouts/AppLayout.astro";
import BackLink from "@/components/app/BackLink.astro";
import InlineAlert from "@/components/app/InlineAlert.astro";
import Panel from "@/components/app/Panel.astro";
import SequenceMark from "@/components/app/SequenceMark.astro";
import { Badge } from "@/components/app/Badge";
import { MonthSelect } from "@/components/patterns/MonthSelect";
import { ThresholdEditor, type ThresholdEditorCopy } from "@/components/patterns/ThresholdEditor";
import { copy, copyExtra } from "@/content/copy";
import { formatIsoDate, formatMoney, formatMonthShort, plural } from "@/lib/format";
import { loadPatterns } from "@/lib/patterns/load";
import { referenceMonth } from "@/lib/patterns/over-limit";
import { keyFromPath } from "@/lib/patterns/path";
import { loadThresholds } from "@/lib/patterns/thresholds";
import { patternDetail, type PatternDetailView } from "@/lib/patterns/view";
import { createClient } from "@/lib/supabase";

const x = copyExtra.patterns;

const key = keyFromPath(Astro.url.pathname);
if (key === null) {
  return Astro.redirect("/patterns");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
let patternsResult: Awaited<ReturnType<typeof loadPatterns>>;
let thresholdsResult: Awaited<ReturnType<typeof loadThresholds>>;
if (supabase) {
  [patternsResult, thresholdsResult] = await Promise.all([loadPatterns(supabase), loadThresholds(supabase)]);
} else {
  const error = new Error("Supabase is not configured");
  patternsResult = { error };
  thresholdsResult = { error };
}

const readError =
  "error" in patternsResult ? patternsResult.error : "error" in thresholdsResult ? thresholdsResult.error : null;
if (readError) {
  // eslint-disable-next-line no-console -- server-side only; the runtime log is the one place this error is visible
  console.error("pattern detail failed", readError);
}

const pattern =
  !readError && "patterns" in patternsResult ? patternsResult.patterns.find((p) => p.key === key) : undefined;

// DESIGN-GAP: G31 — the kit has no "pattern not found" state (e.g. the owning import was deleted, S-04 decision
// 8's idempotent delete leaves no trace for the pattern itself either).
if (!readError && !pattern) {
  Astro.response.status = 404;
}

let detail: PatternDetailView | null = null;
let month = "";
let refMonth: string | null = null;
let monthOptions: { value: string; label: string }[] = [];

if (pattern && "rows" in patternsResult && "thresholds" in thresholdsResult) {
  refMonth = referenceMonth(patternsResult.rows);
  if (!refMonth) {
    // Unreachable: `pattern` was derived from these same `rows`, so a match implies at least one row.
    return Astro.redirect("/patterns");
  }
  const threshold = thresholdsResult.thresholds.get(key) ?? null;
  detail = patternDetail(pattern, patternsResult.rows, threshold, refMonth, Astro.url.searchParams.get("month"));
  month = detail.month ?? refMonth;
  monthOptions = detail.months.map((m) => ({ value: m, label: formatMonthShort(m) }));
}

const monthLocative = (m: string) => x.monthsLocative[Number(m.slice(5, 7)) - 1];
const sumLabel = detail ? x.sumLabel.replace("{month}", monthLocative(month)) : "";
const overLabel = detail
  ? month === refMonth
    ? copy.dashboard.stats[0].label
    : x.overInMonth.replace("{month}", monthLocative(month))
  : "";
const rawDescription = (t: { counterparty: string; title: string }) =>
  t.title ? `${t.counterparty} · ${t.title}` : t.counterparty;
const overCount = detail ? detail.sequence.filter(Boolean).length : 0;
const sequenceSummary = detail
  ? x.sequenceSummary
      .replace("{n}", String(detail.count))
      .replace("{occurrences}", plural(detail.count, x.occurrenceForms))
      .replace("{over}", String(overCount))
  : "";

const editorCopy: ThresholdEditorCopy = {
  acceptedAmount: copy.threshold.acceptedAmount,
  countPerMonth: copy.threshold.countPerMonth,
  sumPerMonth: copy.threshold.sumPerMonth,
  valueLabel: x.valueLabel,
  suffix: x.suffix,
  empty: copy.threshold.empty,
  active: copy.threshold.active,
  setThreshold: x.setThreshold,
  save: copy.threshold.save,
  remove: copy.threshold.remove,
  saving: copyExtra.auth.saving,
};

// Result lines above the editor (S-04 decision 15: redirect + InlineAlert, no Toast component).
const params = Astro.url.searchParams;
const resultAlert = params.get("saved")
  ? { kind: "success" as const, message: copy.components.success }
  : params.get("removed")
    ? { kind: "success" as const, message: x.thresholdRemoved }
    : params.get("error") === "value"
      ? { kind: "error" as const, message: x.thresholdInvalid }
      : params.get("error") === "save"
        ? { kind: "error" as const, message: x.thresholdSaveError }
        : null;
---

<AppLayout title={pattern ? pattern.name : copy.patterns.title} active="patterns">
  <div class="mb-[22px]">
    <BackLink href="/patterns" label={copy.patternDetail.back} />
  </div>
  {readError ? (
    // DESIGN-GAP: K18 — no kit copy for a failed read; reused from /patterns.
    <InlineAlert kind="error">{copy.components.error}</InlineAlert>
  ) : !pattern ? (
    <InlineAlert kind="info">{x.detailMissing}</InlineAlert>
  ) : detail ? (
    <>
      <section class="mb-7 flex items-end justify-between gap-5 max-[899px]:flex-col max-[899px]:items-start max-[899px]:gap-6">
        <div>
          <div class="text-xs font-extrabold tracking-[0.14em] text-excess-text uppercase">
            <Badge tone={pattern.type}>{x.typeLabels[pattern.type]}</Badge>
            {x.detailEyebrow}
          </div>
          <h1 class="mt-3 mb-[7px] text-[44px] tracking-[-0.07em] max-[899px]:text-[38px]">{pattern.name}</h1>
          <p class="m-0 text-muted">{x.typeLeads[pattern.type]}</p>
        </div>
        <div class="text-right max-[899px]:text-left">
          <span class="block text-xs text-muted">{sumLabel}</span>
          <strong class="my-[7px] block text-[28px] tracking-[-0.06em]">{formatMoney(detail.sumMinor)}</strong>
          <small class="block text-xs text-muted">
            {detail.count} {plural(detail.count, x.occurrenceForms)}
          </small>
          <div class="mt-3">
            <span class="block text-xs text-muted">{overLabel}</span>
            <strong class="text-excess-text text-[15px] font-extrabold">{formatMoney(detail.overMinor)}</strong>
          </div>
        </div>
      </section>

      <section class="grid grid-cols-[1fr_1.15fr] gap-[15px] max-[899px]:grid-cols-1">
        <Panel>
          <div class="mb-5 flex items-start justify-between gap-3">
            <h2 class="m-0 text-[17px] tracking-[-0.03em]">{x.thresholdPanel}</h2>
            <span class="text-xs text-muted">{detail.threshold ? x.thresholdActive : x.thresholdNone}</span>
          </div>
          {resultAlert && (
            <div class="mb-4">
              <InlineAlert kind={resultAlert.kind}>{resultAlert.message}</InlineAlert>
            </div>
          )}
          <ThresholdEditor
            client:load
            patternKey={key}
            type={pattern.type}
            threshold={detail.threshold}
            month={month}
            copy={editorCopy}
          />
        </Panel>
        <Panel>
          <div class="mb-5 flex items-start justify-between gap-3">
            <h2 class="m-0 text-[17px] tracking-[-0.03em]">{x.occurrencesPanel}</h2>
            <MonthSelect client:load months={monthOptions} value={month} label={x.occurrencesPanel} />
          </div>
          {detail.count > 0 ? (
            <>
              <div class="flex min-h-[120px] flex-wrap items-center gap-[9px] py-[15px]">
                <span class="sr-only">{sequenceSummary}</span>
                {detail.sequence.map((over) => (
                  <SequenceMark over={over} />
                ))}
              </div>
              <div class="flex justify-between text-xs text-muted">
                <span>{x.sequenceWithin}</span>
                <b class="text-excess-text font-bold">{copyExtra.howItWorks.sequenceOver}</b>
              </div>
            </>
          ) : (
            // DESIGN-GAP: G31 — the kit assumes a pattern always has occurrences in the shown month.
            <p class="text-[13px] text-muted">{x.monthEmpty}</p>
          )}
        </Panel>
      </section>

      <Panel class="mt-[15px]">
        <div class="mb-5 flex items-start justify-between gap-3">
          <h2 class="m-0 text-[17px] tracking-[-0.03em]">{copy.patternDetail.transactions}</h2>
          <span class="text-xs text-muted">{copy.patternDetail.rawDescription}</span>
        </div>
        <div>
          {detail.transactions.map((t) => (
            <div class="flex items-center justify-between border-b border-line py-[14px] last:border-b-0">
              <div>
                <div class="text-[13px] font-bold">{formatIsoDate(t.occurredOn)}</div>
                <div class="mt-[3px] text-[11px] text-muted">{rawDescription(t)}</div>
              </div>
              <div class="flex items-center gap-3">
                <strong class="text-[14px]">{formatMoney(t.amountMinor)}</strong>
                {t.overMinor > 0 && <Badge tone="excess">{x.overBadge}</Badge>}
              </div>
            </div>
          ))}
        </div>
      </Panel>
    </>
  ) : null}
</AppLayout>
