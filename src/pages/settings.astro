---
// Round 3: copy from `settings.*` (K32); loginData/dataLabel/dangerEyebrow/dialog copy stay in copyExtra (K15).
import AppLayout from "@/layouts/AppLayout.astro";
import PageTitle from "@/components/app/PageTitle.astro";
import Panel from "@/components/app/Panel.astro";
import SettingsRow from "@/components/app/SettingsRow.astro";
import InlineAlert from "@/components/app/InlineAlert.astro";
import SettingsPasswordRow from "@/components/settings/SettingsPasswordRow";
import DeleteAccountDialog from "@/components/settings/DeleteAccountDialog";
import { buttonVariants } from "@/components/ui/button";
import { DEMO_EMAIL } from "astro:env/server";
import { isDemoEmail } from "@/lib/demo";
import { getCopy } from "@/content/copy";
import { DELETE_CONFIRM_WORD, MIN_PASSWORD_LENGTH } from "@/lib/auth-rules";

const { copy, copyExtra } = getCopy(Astro.locals.locale);

const s = copy.settings;
const a = copy.authStates;
const f = copy.auth.fields;
const x = copyExtra.settings;
const params = Astro.url.searchParams;
const error = params.get("error");
// The middleware only lets a signed-in user reach /settings, so the address is always there.
// roadmap: change e-mail parked — kit button not rendered
const email = Astro.locals.user?.email;
// One result alert per request (kit `settings()` shows one notice between the title and the first panel).
const notice: { kind: "success" | "error" | "info"; text: string } | null =
  params.get("password") === "changed"
    ? { kind: "success", text: s.passwordSuccess }
    : error === "current-password" || error === "delete-password"
      ? { kind: "error", text: s.passwordInvalid }
      : error === "password"
        ? { kind: "error", text: s.saveError }
        : error === "demo-password"
          ? { kind: "info", text: s.demoPasswordBlocked }
          : error === "delete"
            ? { kind: "error", text: s.deleteError }
            : error === "demo-delete"
              ? { kind: "info", text: s.demoDeleteBlocked }
              : null;
const demo = isDemoEmail(Astro.locals.user?.email, DEMO_EMAIL);
---

<AppLayout title={s.title} active="settings">
  <PageTitle eyebrow={s.eyebrow} title={s.title} lead={s.lead} />
  {notice && (
    <div class="mb-[15px] max-w-[800px]">
      <InlineAlert kind={notice.kind}>{notice.text}</InlineAlert>
    </div>
  )}
  <Panel class="max-w-[800px]">
    <div class="mb-5 flex items-start justify-between">
      <h2 class="m-0 text-[17px] tracking-[-0.03em]">{x.loginData}</h2>
    </div>
    <SettingsRow label={f.email}>
      <strong>{email}</strong>
    </SettingsRow>
    <SettingsPasswordRow
      client:load
      label={f.password}
      masked={copy.auth.passwordPlaceholder}
      toggleLabel={s.changePassword}
      cancelLabel={x.cancel}
      current={{ label: s.currentPassword }}
      formLabels={{
        password: s.newPassword,
        confirm: s.repeatPassword,
        passwordPlaceholder: copy.auth.passwordPlaceholder,
        showPassword: a.showPassword,
        hidePassword: a.hidePassword,
        submit: x.savePassword,
        pending: copyExtra.auth.saving,
        passwordTooShort: a.passwordTooShort.replace("{n}", String(MIN_PASSWORD_LENGTH)),
        passwordsDiffer: a.passwordMismatch,
        currentRequired: a.passwordRequired,
      }}
    />
    <SettingsRow label={x.dataLabel}>
      <p>{s.data}</p>
    </SettingsRow>
    <SettingsRow label={x.session} class="border-t border-line">
      <form method="POST" action="/api/auth/signout" class="col-start-2 col-end-[-1] max-[899px]:col-start-1">
        <button type="submit" class:list={buttonVariants({ variant: "ghost" })}>
          {s.logout}
        </button>
      </form>
    </SettingsRow>
  </Panel>
  <Panel variant="danger" class="mt-[15px] max-w-[800px]">
    <div>
      <div class="text-xs font-extrabold tracking-[0.14em] text-excess-text uppercase">{x.dangerEyebrow}</div>
      <h2 class="my-2 text-[18px]">{s.deleteTitle}</h2>
      <p class="m-0 max-w-[500px] text-[13px] text-muted">{s.deleteBody}</p>
    </div>
    <DeleteAccountDialog
      client:load
      demo={demo}
      labels={{
        trigger: s.deleteButton,
        eyebrow: x.deleteDialogEyebrow,
        title: x.deleteDialogTitle,
        body: x.deleteDialogBody,
        confirmationHint: s.deleteConfirm,
        placeholder: DELETE_CONFIRM_WORD,
        currentPassword: s.deletePassword,
        passwordPlaceholder: copy.auth.passwordPlaceholder,
        confirm: s.deleteButton,
        disabledHelp: s.deleteDisabledHelp,
        demoNote: s.demoDeleteBlocked,
        pending: x.deleting,
        close: x.close,
      }}
    />
  </Panel>
</AppLayout>
